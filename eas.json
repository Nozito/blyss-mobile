{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.blyssapp.fr",
        "EXPO_PUBLIC_WS_URL": "wss://api.blyssapp.fr/ws"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.blyssapp.fr",
        "EXPO_PUBLIC_WS_URL": "wss://staging.blyssapp.fr/ws"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.blyssapp.fr",
        "EXPO_PUBLIC_WS_URL": "wss://app.blyssapp.fr/ws"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "noah2keyzer@outlook.fr",
        "ascAppId": "6770569864",
        "appleTeamId": "B92ST2GG54"
      }
    }
  }
}
