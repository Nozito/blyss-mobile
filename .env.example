# Blyss Mobile — Environment Variables
# Copy this file to .env.local and fill in values

# ─── API ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://api.blyssapp.fr
EXPO_PUBLIC_WS_URL=wss://api.blyssapp.fr

# ─── Stripe ────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── RevenueCat ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# ─── Sentry ────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ─── Admin creation (scripts/create-admin.mjs — ne jamais committer avec de vraies valeurs) ──
NOAH_PASSWORD=          # mot de passe fort pour le compte noah@blyss.fr
NOAH_PHONE=             # numéro de téléphone réel (optionnel, défaut : 0600000000)
NOAH_BIRTH=             # date de naissance YYYY-MM-DD (optionnel, défaut : 1995-01-01)
DB_URL=                 # postgresql://user:pass@host/db (optionnel — promotion admin via SQL)
